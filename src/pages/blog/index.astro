---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CallButton from '../../components/CallButton.astro';
import Photo from '../../components/Photo.astro';
import Icon from '../../components/Icon.astro';
import { absoluteUrl } from '../../config/site';
import { getPostsInLegacyOrder, getAreaLinks, serviceLinks, blogIndex, postHref } from '../../lib/content';
import { blogPhoto } from '../../lib/media';
import { graph, businessNode, websiteNode, webPageNode, breadcrumbNode, ids } from '../../lib/schema';

const path = '/blog/';
const url = absoluteUrl(path);
const areas = await getAreaLinks();
const posts = await getPostsInLegacyOrder();
const items = blogIndex.items;

const jsonLd = [
  graph([
    businessNode({ areas, services: serviceLinks }),
    websiteNode(),
    webPageNode({ url, name: blogIndex.title, description: blogIndex.description, type: 'CollectionPage' }),
    breadcrumbNode(url, [
      { name: 'Home', path: '/' },
      { name: 'Blog', path },
    ]),
    {
      '@type': 'Blog',
      '@id': `${url}#blog`,
      url,
      name: blogIndex.h1,
      description: blogIndex.description,
      publisher: { '@id': ids.business },
      blogPost: posts.map((p) => ({
        '@type': 'BlogPosting',
        headline: p.data.h1,
        url: absoluteUrl(postHref(p.id)),
        datePublished: p.data.datePublished,
      })),
    },
  ]),
];
---

<Base title={blogIndex.title} description={blogIndex.description} path={path} jsonLd={jsonLd}>
  <section class="relative isolate overflow-hidden bg-navy-950 text-white">
    <Photo name="bg-header" alt="" sizes="100vw" widths={[768, 1376]} class="absolute inset-0 -z-20 h-full w-full object-cover opacity-50" />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-navy-950 via-navy-950/90 to-navy-900/60"></div>
    <div class="absolute inset-x-0 bottom-0 -z-10 h-1.5 bg-gradient-to-r from-amber-500 via-amber-400 to-brand-600"></div>
    <div class="container-x py-12 lg:py-20">
      <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Blog' }]} light />
      <h1 class="hero-fade-in mt-6 max-w-4xl text-[clamp(2.3rem,5.2vw,4rem)] leading-[1.02] !text-white">{blogIndex.h1}</h1>
      <p class="hero-fade-in d1 mt-5 max-w-2xl text-lg text-white/85 md:text-xl">{blogIndex.intro}</p>
    </div>
  </section>

  <section class="section bg-mist">
    <div class="container-x">
      <ul class="grid gap-7 md:grid-cols-2 lg:grid-cols-3">
        {
          items.map((it, i) => (
            <li>
              <article class="card card-hover group flex h-full flex-col overflow-hidden">
                <a href={postHref(it.slug)} tabindex="-1" aria-hidden="true">
                  <Photo name={blogPhoto(i)} alt="" sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw" widths={[480, 768]} class="aspect-[16/9] w-full object-cover transition duration-500 group-hover:scale-105" pictureClass="block overflow-hidden" />
                </a>
                <div class="flex flex-1 flex-col p-6 sm:p-7">
                  <p class="flex items-center gap-2 text-sm text-muted">
                    <Icon name="user-round" size={15} class="text-amber-600" />
                    {it.byline}
                  </p>
                  <h2 class="mt-3 text-[1.7rem] leading-tight">
                    <a href={postHref(it.slug)} class="transition hover:text-brand-600">{it.title}</a>
                  </h2>
                  <p class="mt-3 line-clamp-4 text-muted">{it.excerpt}</p>
                  <a href={postHref(it.slug)} class="mt-auto flex items-center gap-1.5 pt-6 font-semibold text-brand-600">
                    Read More <Icon name="arrow-right" size={18} class="transition group-hover:translate-x-1" />
                  </a>
                </div>
              </article>
            </li>
          ))
        }
      </ul>

      <div class="relative mt-16 overflow-hidden rounded-3xl bg-navy-900 p-8 text-white shadow-lift sm:p-12">
        <div class="absolute -right-12 -top-12 h-56 w-56 rounded-full bg-brand-600/30 blur-3xl" aria-hidden="true"></div>
        <h2 class="relative text-3xl !text-white sm:text-4xl">{blogIndex.cta.heading}</h2>
        <p class="relative mt-3 max-w-xl text-lg text-white/85">{blogIndex.cta.text}</p>
        <CallButton label={blogIndex.cta.button} size="lg" class="relative mt-6" location="blog-index-cta" />
      </div>
    </div>
  </section>
</Base>
