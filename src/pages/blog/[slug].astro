---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Prose from '../../components/Prose.astro';
import CallButton from '../../components/CallButton.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Photo from '../../components/Photo.astro';
import Brand from '../../components/Brand.astro';
import Icon from '../../components/Icon.astro';
import { absoluteUrl } from '../../config/site';
import { getPosts, getAreaLinks, serviceLinks, postHref, formatDate } from '../../lib/content';
import { blogPhoto } from '../../lib/media';
import { enhanceProse } from '../../lib/prose';
import { graph, businessNode, websiteNode, webPageNode, breadcrumbNode, blogPostingNode } from '../../lib/schema';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const slug = entry.id;
const path = `/blog/${slug}`;
const url = absoluteUrl(path);

const areas = await getAreaLinks();
const { html, toc } = enhanceProse(d.bodyHtml);
const tocItems = toc.filter((t) => t.level === 2);

// Services this article already links to → "related services" cards (no new copy, just surfaced links).
const linked = [...new Set([...d.bodyHtml.matchAll(/href=["']\/services\/([a-z0-9-]+)["']/g)].map((m) => m[1]!))];
const related = linked.map((s) => serviceLinks.find((x) => x.slug === s)).filter(Boolean).slice(0, 3) as typeof serviceLinks;

const all = await getPosts();
const idx = all.findIndex((p) => p.id === slug);
const more = [...all.slice(idx + 1), ...all.slice(0, idx)].slice(0, 3);

const crumbs = [{ name: 'Home', href: '/' }, { name: 'Blog', href: '/blog/' }, { name: d.h1 }];

const jsonLd = [
  graph([
    businessNode({ areas, services: serviceLinks }),
    websiteNode(),
    webPageNode({ url, name: d.title, description: d.description, type: 'WebPage', dateModified: d.dateModified }),
    breadcrumbNode(url, [
      { name: 'Home', path: '/' },
      { name: 'Blog', path: '/blog/' },
      { name: d.h1, path },
    ]),
    blogPostingNode({ url, headline: d.h1, description: d.description, datePublished: d.datePublished, dateModified: d.dateModified }),
  ]),
];
---

<Base
  title={d.title}
  description={d.description}
  path={path}
  ogType="article"
  article={{ published: d.datePublished, modified: d.dateModified }}
  jsonLd={jsonLd}
>
  <section class="relative isolate overflow-hidden bg-navy-950 text-white">
    <Photo name="bg-header" alt="" sizes="100vw" widths={[768, 1376]} class="absolute inset-0 -z-20 h-full w-full object-cover opacity-45" />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-navy-950 via-navy-950/92 to-navy-900/70"></div>
    <div class="absolute inset-x-0 bottom-0 -z-10 h-1.5 bg-gradient-to-r from-amber-500 via-amber-400 to-brand-600"></div>
    <div class="container-x py-10 lg:py-16">
      <Breadcrumbs items={crumbs} light />
      <h1 class="hero-fade-in mt-6 max-w-4xl text-[clamp(2.1rem,4.6vw,3.6rem)] leading-[1.04] !text-white">{d.h1}</h1>
      <p class="hero-fade-in d1 mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 text-white/80">
        <span class="flex items-center gap-2"><Icon name="user-round" size={18} class="text-amber-400" />{d.author}</span>
        <span class="flex items-center gap-2"><Icon name="calendar" size={18} class="text-amber-400" /><time datetime={d.datePublished}>{formatDate(d.datePublished)}</time></span>
      </p>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-x grid gap-12 lg:grid-cols-12 lg:gap-14">
      <article class="lg:col-span-8">
        <p class="rounded-2xl border-l-[5px] border-amber-500 bg-amber-50 p-6 text-xl italic leading-relaxed text-navy-900">{d.summary}</p>
        <Prose html={html} enhanced class="mt-10" />

        <div class="relative mt-14 overflow-hidden rounded-3xl bg-navy-900 p-8 text-white shadow-lift sm:p-10">
          <div class="absolute -right-12 -top-12 h-52 w-52 rounded-full bg-brand-600/30 blur-3xl" aria-hidden="true"></div>
          <h2 class="relative text-3xl !text-white sm:text-4xl">{d.cta.heading}</h2>
          <p class="relative mt-3 max-w-xl text-lg text-white/85">{d.cta.text}</p>
          <CallButton label={d.cta.button} size="lg" class="relative mt-6" location="blog-cta" />
        </div>
      </article>

      <aside class="lg:col-span-4" aria-label="Article tools">
        <div class="space-y-6 lg:sticky lg:top-28">
          {
            tocItems.length > 2 && (
              <nav class="card p-6" aria-label="On this page">
                <p class="font-display text-xl font-bold uppercase tracking-wider text-navy-900">On this page</p>
                <ol class="mt-4 space-y-2.5 border-l-2 border-line pl-4">
                  {tocItems.map((t) => (
                    <li>
                      <a href={`#${t.id}`} class="block text-[0.98rem] leading-snug text-muted transition hover:text-brand-700">{t.text}</a>
                    </li>
                  ))}
                </ol>
              </nav>
            )
          }
          <div class="rounded-3xl bg-navy-900 p-6 text-white">
            <Brand name="badge-emergency" alt="" width={96} class="h-auto w-24 drop-shadow-xl" />
            <p class="mt-4 font-display text-2xl font-bold leading-tight text-white">24/7 Emergency Service</p>
            <CallButton class="mt-4 w-full" location="blog-sidebar" />
          </div>
        </div>
      </aside>
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="section bg-mist" aria-labelledby="related-heading">
        <div class="container-x">
          <SectionHeading kicker="Services mentioned" title="Related plumbing services" />
          <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((s) => <ServiceCard slug={s.slug} name={s.name} href={s.href} compact />)}
          </div>
        </div>
      </section>
    )
  }

  <section class="section bg-white" aria-labelledby="more-heading">
    <div class="container-x">
      <SectionHeading kicker="Keep reading" title="More from the blog" />
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {
          more.map((p) => (
            <a href={postHref(p.id)} class="card card-hover group flex h-full flex-col overflow-hidden">
              <Photo name={blogPhoto(all.findIndex((x) => x.id === p.id))} alt="" sizes="(min-width: 768px) 33vw, 100vw" widths={[480, 768]} class="aspect-[16/9] w-full object-cover" />
              <span class="flex flex-1 flex-col p-6">
                <span class="font-display text-2xl font-bold leading-tight text-navy-900">{p.data.h1}</span>
                <span class="mt-auto flex items-center gap-1.5 pt-5 font-semibold text-brand-600">Read More <Icon name="arrow-right" size={18} class="transition group-hover:translate-x-1" /></span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>
