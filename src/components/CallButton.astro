---
import Icon from './Icon.astro';
import { SITE, telHref } from '../config/site';

interface Props {
  /** Visible label. Defaults to the phone number. */
  label?: string;
  variant?: 'amber' | 'navy' | 'outline' | 'outline-light';
  size?: 'md' | 'lg';
  class?: string;
  icon?: boolean;
  /** analytics / test hook */
  location?: string;
}
const { label = SITE.phone, variant = 'amber', size = 'md', class: className = '', icon = true, location } = Astro.props;
const sizeCls = size === 'lg' ? 'text-lg md:text-xl px-7 py-4' : 'text-base';
---

<a href={telHref} class:list={['btn', `btn-${variant}`, sizeCls, className]} data-call={location}>
  {icon && <Icon name="phone-call" size={size === 'lg' ? 24 : 20} />}
  <span>{label}</span>
</a>
