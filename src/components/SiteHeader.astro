---
import Icon from './Icon.astro';
import Brand from './Brand.astro';
import CallButton from './CallButton.astro';
import { SITE } from '../config/site';
import { serviceLinks, getAreaLinks, GROUP_LABEL, type ServiceGroup } from '../lib/content';
import { serviceIcon } from '../lib/icons';

interface Props {
  /** current pathname, used to mark the active top-level link */
  current?: string;
}
const { current = '' } = Astro.props;
const areas = await getAreaLinks();
const groups: ServiceGroup[] = ['repair', 'installation'];
const isActive = (prefix: string) => current === prefix || current.startsWith(prefix + '/');
const navLink = 'rounded-lg px-3.5 py-2 font-semibold text-navy-900 transition hover:bg-brand-50 hover:text-brand-700';
---

<header id="site-header" class="sticky top-0 z-50 border-b border-line bg-white/95 backdrop-blur supports-[backdrop-filter]:bg-white/85">
  <div class="container-x flex h-[4.5rem] items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-3" aria-label={`${SITE.name} — home`}>
      <Brand name="logo-mark" alt="" width={44} class="h-11 w-auto" priority />
      <span class="leading-none">
        <span class="block font-display text-[1.55rem] font-bold uppercase tracking-tight text-navy-900 sm:text-[1.7rem]">Buffalo Plumbing</span>
        <span class="mt-0.5 block font-display text-[0.8rem] font-semibold uppercase tracking-[0.42em] text-brand-600">PROS</span>
      </span>
    </a>

    <nav class="hidden items-center gap-1 self-stretch lg:flex" aria-label="Primary">
      <a href="/" class={navLink} aria-current={current === '/' ? 'page' : undefined}>Home</a>

      <div class="nav-item">
        <button type="button" class={`${navLink} flex items-center gap-1.5`} aria-expanded="false" aria-controls="mega-services" data-nav-toggle>
          Services <Icon name="chevron-down" size={16} class="nav-chevron transition" />
        </button>
        <div id="mega-services" class="mega">
          <div class="container-x">
            <div class="grid grid-cols-12 gap-8 py-8">
              {
                groups.map((g) => (
                  <div class="col-span-4">
                    <p class="mb-3 border-b border-line pb-2 font-display text-lg font-bold uppercase tracking-wider text-navy-900">{GROUP_LABEL[g]}</p>
                    <ul class="space-y-0.5">
                      {serviceLinks
                        .filter((s) => s.group === g)
                        .map((s) => (
                          <li>
                            <a href={s.href} class="group flex items-center gap-2.5 rounded-lg px-2 py-1.5 text-[0.97rem] leading-snug text-ink transition hover:bg-brand-50 hover:text-brand-700">
                              <Icon name={serviceIcon(s.slug)} size={18} class="shrink-0 text-brand-600" />
                              <span>{s.name}</span>
                            </a>
                          </li>
                        ))}
                    </ul>
                  </div>
                ))
              }
              <div class="col-span-4 self-start rounded-2xl bg-navy-900 p-6 text-white">
                <p class="kicker kicker-light">Plumbing emergency?</p>
                <p class="mt-3 font-display text-3xl font-bold leading-tight text-white">Same-day service. 24/7 emergency response.</p>
                <CallButton class="mt-5 w-full" location="mega-services" />
                <a href="/#services" class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-amber-400 hover:text-white">
                  Browse all services <Icon name="arrow-right" size={16} />
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="nav-item">
        <button type="button" class={`${navLink} flex items-center gap-1.5`} aria-expanded="false" aria-controls="mega-areas" data-nav-toggle>
          Areas <Icon name="chevron-down" size={16} class="nav-chevron transition" />
        </button>
        <div id="mega-areas" class="mega">
          <div class="container-x">
            <div class="grid grid-cols-12 gap-8 py-8">
              <div class="col-span-8">
                <p class="mb-3 border-b border-line pb-2 font-display text-lg font-bold uppercase tracking-wider text-navy-900">Buffalo neighborhoods we serve</p>
                <ul class="grid grid-cols-3 gap-x-4 gap-y-0.5">
                  {
                    areas.map((a) => (
                      <li>
                        <a href={a.href} class="flex items-center justify-between gap-2 rounded-lg px-2 py-1.5 text-[0.97rem] text-ink transition hover:bg-brand-50 hover:text-brand-700">
                          <span class="flex items-center gap-2">
                            <Icon name="map-pin" size={16} class="shrink-0 text-amber-600" />
                            {a.name}
                          </span>
                          <span class="text-sm text-muted">{a.zip}</span>
                        </a>
                      </li>
                    ))
                  }
                </ul>
              </div>
              <div class="col-span-4 self-start rounded-2xl bg-navy-900 p-6 text-white">
                <p class="kicker kicker-light">Serving Buffalo, NY</p>
                <p class="mt-3 font-display text-3xl font-bold leading-tight text-white">Local plumbers in every Buffalo zip code.</p>
                <CallButton class="mt-5 w-full" location="mega-areas" />
              </div>
            </div>
          </div>
        </div>
      </div>

      <a href="/blog/" class={navLink} aria-current={isActive('/blog') ? 'page' : undefined}>Blog</a>
      <CallButton class="ml-3" location="header" />
    </nav>

    <button
      type="button"
      class="grid h-11 w-11 place-items-center rounded-xl border border-line text-navy-900 lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
      data-mobile-toggle
    >
      <Icon name="menu" size={24} class="icon-open" />
      <Icon name="x" size={24} class="icon-close hidden" />
    </button>
  </div>

  <div id="mobile-menu" class="h-[calc(100dvh-4.5rem)] overflow-y-auto border-t border-line bg-white lg:hidden" hidden>
    <div class="container-x space-y-1 py-4">
      <a href="/" class="block rounded-lg px-3 py-3 text-lg font-semibold text-navy-900">Home</a>
      <details class="group rounded-lg">
        <summary class="flex cursor-pointer list-none items-center justify-between rounded-lg px-3 py-3 text-lg font-semibold text-navy-900">
          Services <Icon name="chevron-down" size={20} class="transition group-open:rotate-180" />
        </summary>
        <div class="pb-2 pl-3">
          {
            groups.map((g) => (
              <div>
                <p class="mt-2 px-3 font-display text-sm font-bold uppercase tracking-widest text-brand-600">{GROUP_LABEL[g]}</p>
                <ul>
                  {serviceLinks
                    .filter((s) => s.group === g)
                    .map((s) => (
                      <li>
                        <a href={s.href} class="flex items-center gap-2.5 rounded-lg px-3 py-2.5 text-[1rem] text-ink">
                          <Icon name={serviceIcon(s.slug)} size={18} class="shrink-0 text-brand-600" />
                          {s.name}
                        </a>
                      </li>
                    ))}
                </ul>
              </div>
            ))
          }
        </div>
      </details>
      <details class="group rounded-lg">
        <summary class="flex cursor-pointer list-none items-center justify-between rounded-lg px-3 py-3 text-lg font-semibold text-navy-900">
          Areas <Icon name="chevron-down" size={20} class="transition group-open:rotate-180" />
        </summary>
        <ul class="pb-2 pl-3">
          {
            areas.map((a) => (
              <li>
                <a href={a.href} class="flex items-center gap-2.5 rounded-lg px-3 py-2.5 text-[1rem] text-ink">
                  <Icon name="map-pin" size={16} class="shrink-0 text-amber-600" />
                  {a.name}
                  <span class="ml-auto text-sm text-muted">{a.zip}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </details>
      <a href="/blog/" class="block rounded-lg px-3 py-3 text-lg font-semibold text-navy-900">Blog</a>
      <a href="/#contact" class="block rounded-lg px-3 py-3 text-lg font-semibold text-navy-900">Contact</a>
      <div class="pt-3">
        <CallButton size="lg" class="w-full" location="mobile-menu" />
      </div>
    </div>
  </div>
</header>

<style>
  /* each item spans the full header height so the pointer never leaves it on the way to the panel */
  .nav-item {
    display: flex;
    align-items: center;
    align-self: stretch;
  }
  .mega {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    display: none;
    background: #fff;
    border-bottom: 1px solid var(--color-line);
    box-shadow: 0 30px 40px -24px rgb(10 35 66 / 0.35);
  }
  .nav-item:hover > .mega,
  .nav-item:focus-within > .mega,
  .nav-item[data-open='true'] > .mega {
    display: block;
    animation: mega-in 0.16s ease-out both;
  }
  .nav-item:hover .nav-chevron,
  .nav-item[data-open='true'] .nav-chevron {
    transform: rotate(180deg);
  }
  @keyframes mega-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  const header = document.getElementById('site-header')!;
  const toggles = header.querySelectorAll<HTMLButtonElement>('[data-nav-toggle]');
  const closeAll = () =>
    toggles.forEach((b) => {
      b.setAttribute('aria-expanded', 'false');
      b.closest('.nav-item')?.removeAttribute('data-open');
    });

  toggles.forEach((btn) =>
    btn.addEventListener('click', () => {
      const item = btn.closest('.nav-item')!;
      const open = item.getAttribute('data-open') !== 'true';
      closeAll();
      if (open) {
        item.setAttribute('data-open', 'true');
        btn.setAttribute('aria-expanded', 'true');
      }
    }),
  );
  document.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('.nav-item')) closeAll();
  });

  const mobileBtn = header.querySelector<HTMLButtonElement>('[data-mobile-toggle]')!;
  const mobileMenu = document.getElementById('mobile-menu')!;
  const setMobile = (open: boolean) => {
    mobileMenu.hidden = !open;
    document.documentElement.style.overflow = open ? 'hidden' : '';
    mobileBtn.setAttribute('aria-expanded', String(open));
    mobileBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    mobileBtn.querySelector('.icon-open')?.classList.toggle('hidden', open);
    mobileBtn.querySelector('.icon-close')?.classList.toggle('hidden', !open);
  };
  mobileBtn.addEventListener('click', () => setMobile(mobileMenu.hidden));
  mobileMenu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMobile(false)));

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeAll();
      // :focus-within also opens the panels, so release focus from the nav as well
      const active = document.activeElement as HTMLElement | null;
      if (active && active.closest('.nav-item')) active.blur();
      if (!mobileMenu.hidden) {
        setMobile(false);
        mobileBtn.focus();
      }
    }
  });
</script>
