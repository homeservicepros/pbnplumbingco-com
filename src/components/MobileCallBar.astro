---
import Icon from './Icon.astro';
import { SITE, telHref } from '../config/site';
---

<aside aria-label="Call us" class="fixed inset-x-0 bottom-0 z-40 border-t border-white/10 bg-navy-950/95 px-3 pb-[max(0.6rem,env(safe-area-inset-bottom))] pt-2.5 backdrop-blur lg:hidden">
  <a href={telHref} class="btn btn-amber w-full text-lg" data-call="mobile-bar">
    <Icon name="phone-call" size={22} />
    <span>Call {SITE.phone}</span>
  </a>
</aside>
