---
import '@fontsource/barlow/latin-400.css';
import '@fontsource/barlow/latin-600.css';
import '@fontsource/barlow/latin-700.css';
import '@fontsource/barlow-condensed/latin-700.css';
import '../styles/global.css';

import barlow400 from '@fontsource/barlow/files/barlow-latin-400-normal.woff2?url';
import barlowCondensed700 from '@fontsource/barlow-condensed/files/barlow-condensed-latin-700-normal.woff2?url';

import TopBar from '../components/TopBar.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MobileCallBar from '../components/MobileCallBar.astro';
import { getImage } from 'astro:assets';
import { SITE, absoluteUrl } from '../config/site';
import { photo, type PhotoName } from '../lib/media';

interface Props {
  title: string;
  description: string;
  /** Pathname exactly as the legacy site served it, e.g. "/services/drain-repair-buffalo-ny" or "/blog/" */
  path: string;
  ogImage?: string;
  /** Use a build-time 1200×630 crop of one of the site photos as the social image. */
  ogPhoto?: PhotoName;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  /** JSON-LD documents (each already wrapped with @context/@graph) */
  jsonLd?: object[];
  showRating?: boolean;
  /** article:published_time etc. */
  article?: { published: string; modified: string };
}

const {
  title,
  description,
  path,
  ogImage = '/og-default.jpg',
  ogPhoto,
  ogImageAlt = `${SITE.name} — residential plumbing services in Buffalo, NY`,
  ogType = 'website',
  noindex = false,
  jsonLd = [],
  showRating = false,
  article,
} = Astro.props;

const canonical = absoluteUrl(path);
const ogImageUrl = ogPhoto
  ? absoluteUrl((await getImage({ src: photo(ogPhoto), width: 1200, height: 630, fit: 'cover', format: 'jpeg', quality: 82 })).src)
  : absoluteUrl(ogImage);
const robots = noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0a2342" />
    <meta name="author" content={SITE.name} />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    {article && <meta property="article:published_time" content={article.published} />}
    {article && <meta property="article:modified_time" content={article.modified} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <link rel="preload" href={barlow400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={barlowCondensed700} as="font" type="font/woff2" crossorigin />

    {jsonLd.map((doc) => <script type="application/ld+json" set:html={JSON.stringify(doc)} />)}

    {
      import.meta.env.PROD && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.googleAnalyticsId}`} />
          <script is:inline define:vars={{ gaId: SITE.googleAnalyticsId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', gaId);
          </script>
        </>
      )
    }
  </head>
  <body>
    <a href="#main" class="sr-only z-[100] rounded-lg bg-amber-500 px-4 py-2 font-bold text-navy-950 focus:not-sr-only focus:fixed focus:left-3 focus:top-3">Skip to content</a>
    <TopBar />
    <SiteHeader current={path} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter showRating={showRating} />
    <MobileCallBar />
  </body>
</html>
